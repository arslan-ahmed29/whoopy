# Copy this file to .env and fill in your WHOOP app credentials.
# Create an app at https://developer.whoop.com (Developer Dashboard).
#
# In the dashboard, set the app's Redirect URL to:
#   http://localhost:3000/auth/callback
# and enable these scopes:
#   read:profile read:recovery read:cycles read:sleep read:workout read:body_measurement offline

WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here

# Must exactly match a Redirect URL configured in the WHOOP Developer Dashboard
WHOOP_REDIRECT_URI=http://localhost:3000/auth/callback

PORT=3000
