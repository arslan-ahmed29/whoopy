# whoopy supports two data sources:
#
# 1. LOCAL MODE (no WHOOP membership needed) — reads the SQLite database
#    synced from your band by the openwhoop CLI
#    (https://github.com/bWanShiTong/openwhoop). This is auto-selected when
#    the database exists and no API credentials are set. To force it:
#
# WHOOPY_SOURCE=openwhoop
# OPENWHOOP_DB=/home/you/.openwhoop/db.sqlite   # default: ~/.openwhoop/db.sqlite
#
# 2. WHOOP CLOUD API (requires an active WHOOP membership):
#    Copy this file to .env and fill in your WHOOP app credentials.
# Create an app at https://developer.whoop.com (Developer Dashboard).
#
# In the dashboard, set the app's Redirect URL to:
#   http://localhost:3001/auth/callback
# and enable these scopes:
#   read:profile read:recovery read:cycles read:sleep read:workout read:body_measurement offline

WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here

# Must exactly match a Redirect URL configured in the WHOOP Developer Dashboard
WHOOP_REDIRECT_URI=http://localhost:3001/auth/callback

PORT=3001
